APP_NAME=SafeSite Intelligence
DATABASE_URL=sqlite:///./data/safesite.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
AUTO_SEED=true
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# mock works offline with no API key. real NEVER silently falls back to mock.
# AI_PROVIDER remains a supported legacy alias; SAFESITE_AI_PROVIDER takes precedence.
SAFESITE_AI_PROVIDER=mock
# Workloads are independent; omit reinspection settings to inherit vision.
# Supported real providers: openai, deepseek. No automatic fallback.
SAFESITE_VISION_PROVIDER=mock
# SAFESITE_REINSPECTION_PROVIDER=deepseek
# SAFESITE_REINSPECTION_MODEL=deepseek-flash
# DeepSeek image workloads require deepseek-flash; deepseek-v4-pro is text-only.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
SAFESITE_VISION_MODEL=gpt-5.6-terra
# Keep V1 as default. vision-v2 is experimental; no overall superiority claim.
SAFESITE_VISION_PROMPT_VERSION=vision-v1
SAFESITE_AI_TIMEOUT_SECONDS=90
SAFESITE_AI_MAX_OUTPUT_TOKENS=6000

# Local semantic embeddings; initial model download occurs only via the ingestion CLI.
SAFESITE_EMBEDDING_PROVIDER=fastembed
SAFESITE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SAFESITE_EMBEDDING_CACHE_DIR=./data/knowledge/models
SAFESITE_KNOWLEDGE_SOURCE_DIR=./data/knowledge/sources
SAFESITE_RETRIEVAL_MIN_SEMANTIC=0.55
SAFESITE_RETRIEVAL_MIN_SCORE=0.55
# Optional remote embeddings: set provider=openai, a compatible embedding model, and OPENAI_API_KEY.

# Safety analytics: deterministic queries use actual DB data without an API key.
SAFESITE_ANALYST_PROVIDER=deterministic
SAFESITE_ANALYST_MODEL=gpt-5.6-terra
SAFESITE_ANALYST_TIMEOUT_SECONDS=30

# Optional reviewed pricing registry; absent/unknown pricing yields null cost.
# SAFESITE_PRICING_FILE=./app/core/provider_pricing.json
